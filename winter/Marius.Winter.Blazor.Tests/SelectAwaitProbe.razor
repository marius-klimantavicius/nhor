@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Marius.Winter.Blazor.Elements
@namespace Marius.Winter.Blazor.Tests
<FilePicker @bind-IsOpen:get="Model.Open" @bind-IsOpen:set="Model.Set" Selected="Model.Select"
            Provider="Provider" InitialDirectory="/" />
<Label Text="@($"Unrelated label {Tick}")" />
@code {
    public sealed class PickerModel
    {
        public bool Open = true;
        public int Changes, Results;
        public void Set(bool value) { Open = value; Changes++; }
        public void Select(FilePickerResult result) { if (!result.Accepted) throw new System.Exception("Expected accepted provider result"); Results++; }
    }
    public PickerModel Model = new();
    public SelectGateProvider Provider = new();
    public int Tick;
    public void Refresh() { Tick++; StateHasChanged(); }
}
