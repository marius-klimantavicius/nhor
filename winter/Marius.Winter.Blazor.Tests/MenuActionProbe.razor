@using Microsoft.AspNetCore.Components
@using Marius.Winter.Blazor.Elements
<Panel>
    <Button Text="Context owner">
        @if (Attached) { <ContextMenu><MenuItem Label="Context preview" OnClick="ContextAction" ResetVersion="Reset" /></ContextMenu> }
    </Button>
    <MenuBar><Menu Title="Preview"><MenuItem Label="Save preview" Enabled="SaveEnabled" OnClick="Action" ResetVersion="Reset" /></Menu></MenuBar>
</Panel>
@code {
    [Parameter] public bool SaveEnabled { get; set; }
    [Parameter] public EventCallback Action { get; set; }
    [Parameter] public EventCallback ContextAction { get; set; }
    [Parameter] public long Reset { get; set; }
    private bool Attached = true;
    public void Update(bool enabled, bool detailed, string[] keys, long reset = 0) { SaveEnabled = enabled; Reset = reset; StateHasChanged(); }
    public void Context(bool attached) { Attached = attached; StateHasChanged(); }
    public void ReplaceAction(EventCallback action) { Action = action; StateHasChanged(); }
    public void Rerender() => StateHasChanged();
}
