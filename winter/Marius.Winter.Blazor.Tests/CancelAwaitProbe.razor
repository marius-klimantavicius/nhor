@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Marius.Winter.Blazor.Elements
@namespace Marius.Winter.Blazor.Tests
@if (Show)
{
    <FilePicker @bind-IsOpen:get="Model.Open" @bind-IsOpen:set="Model.Set" Canceled="Model.Cancel"
                OnIsOpenChanged="Legacy" Provider="Provider" InitialDirectory="/" ResetVersion="Version" />
}
@code {
    public sealed class PickerModel
    {
        public bool Open = true;
        public List<string> Order = new();
        public TaskCompletionSource Gate = new(TaskCreationOptions.RunContinuationsAsynchronously);
        public TaskCompletionSource Finished = new(TaskCreationOptions.RunContinuationsAsynchronously);
        public async Task Set(bool value) { Open = value; Order.Add("open"); await Gate.Task; }
        public async Task Cancel(FilePickerResult result) { if (result.Accepted) throw new Exception("Expected typed cancel"); Order.Add("cancel"); await Gate.Task; Finished.SetResult(); }
    }
    public PickerModel Model = new();
    public PickerBindingProvider Provider = new();
    public bool Show = true;
    public long Version;
    public int LegacyChanges;
    void Legacy(bool _) => LegacyChanges++;
    public void Refresh() => StateHasChanged();
}
