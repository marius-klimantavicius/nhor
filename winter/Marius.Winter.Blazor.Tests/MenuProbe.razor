@using Microsoft.AspNetCore.Components
@using Marius.Winter.Blazor.Elements

<Panel>
    <Button Text="Preview owner">
        @if (Attached)
        {
            <ContextMenu @key="ContextKey">
                <MenuItem Label="Context preview" OnClick="ContextAction" ResetVersion="Reset" />
                <MenuSeparator />
                <SubMenu Label="Context zoom"><MenuItem Label="125%" OnClick="ContextAction" /></SubMenu>
            </ContextMenu>
        }
    </Button>
    <MenuBar>
        <Menu Title="Preview">
            <MenuItem Label="Save preview" Enabled="SaveEnabled" OnClick="Action" ResetVersion="Reset" />
            <MenuItem Label="Detailed view" @bind-IsChecked="Detailed" OnCheckedChanged="LegacyCheck" Shortcut="Ctrl+D" ResetVersion="Reset" />
            <MenuSeparator @key="SeparatorKey" />
            <SubMenu Label="Zoom" @key="ZoomKey">
                @foreach (var key in Keys)
                {
                    <MenuItem @key="key" Label="@key" OnClick="@(() => Activated.InvokeAsync(key))" />
                }
            </SubMenu>
        </Menu>
    </MenuBar>
</Panel>

@code {
    [Parameter] public bool SaveEnabled { get; set; }
    [Parameter] public bool Detailed { get; set; }
    [Parameter] public string[] Keys { get; set; } = ["100%", "125%", "150%"];
    [Parameter] public EventCallback Action { get; set; }
    [Parameter] public EventCallback ContextAction { get; set; }
    [Parameter] public EventCallback<string> Activated { get; set; }
    [Parameter] public EventCallback<bool> LegacyCheck { get; set; }
    [Parameter] public long Reset { get; set; }
    [Parameter] public bool Attached { get; set; } = true;
    private static readonly object SeparatorKey = new(), ZoomKey = new();
    private object ContextKey = new();
    public void Update(bool enabled, bool detailed, string[] keys, long reset = 0)
    { SaveEnabled = enabled; Detailed = detailed; Keys = keys; Reset = reset; StateHasChanged(); }
    public void Context(bool attached) { Attached = attached; StateHasChanged(); }
    public void ReplaceAction(EventCallback action) { Action = action; StateHasChanged(); }
    public void Rerender() => StateHasChanged();
}
