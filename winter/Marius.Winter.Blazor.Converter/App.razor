@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

<Panel>
    <GridLayout Columns="@(new[] { TrackSize.Px(220), TrackSize.Fr(1) })" Rows="@(new[] { TrackSize.Auto(), TrackSize.Fr(1), TrackSize.Auto() })" />
    <PathPicker Label="Source file" Value="_selectedPath" ValueChanged="PathEdited" Provider="_provider"
                Mode="FilePickerMode.OpenFile" InitialDirectory="@_directory" Filters="_sourceFilters" Selected="SourcePicked"
                TextCommitted="SourceCommitted" ReadOnly="_converting" HelpText="Browse for a source, or type a path and press Enter or Convert to load it."
                LayoutData="@(new GridItem { Column = 0, Row = 0, ColumnSpan = 2 })" />
    <Panel LayoutData="@(new GridItem { Column = 0, Row = 1 })">
        <FlexLayout Direction="Orientation.Vertical" Gap="6" />
        <Label Text="Source browser" />
        <Button Text="Refresh browser" OnClick="RefreshBrowser" />
        <DataTree TItem="FilePickerEntry" Items="_roots" KeySelector="@(i => i.Path.Value)" TextSelector="@(i => i.Name)"
                  MayHaveChildren="@(i => i.IsDirectory)" LoadChildren="ListChildren"
                  @bind-SelectedKey="_sidebarSelected" @bind-ExpandedKeys="_expanded" OnActivate="SidebarActivate"
                  ResetVersion="_browserVersion" LayoutData="@(new FlexItem { Grow = 1, Shrink = 1, Basis = 0 })" />
    </Panel>
    <Panel LayoutData="@(new GridItem { Column = 1, Row = 1 })">
        <FlexLayout Direction="Orientation.Vertical" Gap="8" />
        <Panel LayoutData="@(new FlexItem { Grow = 1, Shrink = 1, Basis = 0 })">
            <GridLayout Columns="@(new[] { TrackSize.Fr(1), TrackSize.Fr(1) })" Rows="@(new[] { TrackSize.Auto(), TrackSize.Fr(1) })" ColumnGap="8" />
            <Label Text="Source" LayoutData="@(new GridItem { Column = 0, Row = 0 })" />
            <Label Text="Converted" LayoutData="@(new GridItem { Column = 1, Row = 0 })" />
            <Panel LayoutData="@(new GridItem { Column = 0, Row = 1 })">
                @if (_sourceSvg != null) { <SvgImage Svg="@_sourceSvg" /> }
                else if (_lottiePath != null) { <LottieImage Path="@_lottiePath" /> }
                else { <Label Text="No file loaded" /> }
            </Panel>
            <Panel LayoutData="@(new GridItem { Column = 1, Row = 1 })">
                @if (_convertedSaveData != null && _fileKind == FileKind.Svg) { <Image Source="_convertedSaveData" MimeType="png" /> }
                else if (_convertedSaveData != null && _fileKind == FileKind.Lottie) { <GifImage Source="_convertedSaveData" /> }
                else { <Label Text="Not yet converted" /> }
            </Panel>
        </Panel>
        <Panel>
            <FlexLayout Wrap="FlexWrap.Wrap" Gap="8" />
            <Button Text="Reload source" OnClick="ReloadSource" Enabled="@(!_converting && _selectedPath != null)" />
            <Button Text="Convert" OnClick="DoConvert" Enabled="@(_selectedPath != null && !_converting)" />
            <Button Text="Save As…" OnClick="OpenSave" Enabled="@(_convertedSaveData != null && !_converting)" />
        </Panel>
    </Panel>
    <Panel LayoutData="@(new GridItem { Column = 0, Row = 2, ColumnSpan = 2 })">
        <FlexLayout Direction="Orientation.Vertical" Gap="4" />
        <StatusPanel Status="_status" Retry="Retry" ShowProgress="false" />
        <LogView Buffer="_logs" MinHeight="60" MaxHeight="80" />
    </Panel>
    <FilePicker @bind-IsOpen="_saveOpen" Mode="FilePickerMode.SaveFile" InitialDirectory="@_directory" FileName="@_saveName"
                Provider="_provider" Filters="_outputFilters" Selected="SaveSelected" Canceled="SaveCanceled" ResetVersion="_saveVersion" />
</Panel>

@code {
    [Parameter] public Window? OwnerWindow { get; set; }
    [Parameter] public string? WorkspaceDirectory { get; set; }
    [Parameter] public string? SettingsDirectory { get; set; }
    [Parameter] public IFilePickerProvider? FileProvider { get; set; }
    readonly FilePickerFilter[] _sourceFilters = [new("SVG and Lottie", ".svg", ".json", ".lottie", ".lot"), new("SVG", ".svg"), new("Lottie", ".json", ".lottie", ".lot")];
    FilePickerFilter[] _outputFilters = [];
    IFilePickerProvider _provider = null!;
    IReadOnlyList<FilePickerEntry> _roots = [];
    IReadOnlySet<string> _expanded = new HashSet<string>();
    string? _sidebarSelected;
    string _directory = "", _saveName = "";
    PickerPath? _selectedPath, _loadedPath;
    FileKind _fileKind;
    string? _sourceSvg, _lottiePath;
    byte[]? _convertedSaveData;
    bool _converting, _saveOpen, _disposed;
    readonly System.Threading.CancellationTokenSource _lifetime = new();
    Task _conversionTask = Task.CompletedTask;
    long _browserVersion, _saveVersion, _generation;
    enum ActionKind { Load, Convert, Save }
    ActionKind _lastAction;
    OperationStatus _status = new("Choose an SVG or Lottie source, convert it, then save the output.");
    readonly LogBuffer _logs = new(100, 20000);
    string SettingsPath => System.IO.Path.Combine(SettingsDirectory ?? System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Marius.Winter.Blazor.Converter"), "sidebar.txt");

    protected override void OnInitialized()
    {
        _provider = FileProvider ?? new LocalFilePickerProvider(WorkspaceDirectory);
        _directory = WorkspaceDirectory ?? Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        try { if (WorkspaceDirectory == null && File.Exists(SettingsPath)) _directory = _provider.Normalize(File.ReadAllText(SettingsPath).Trim()).Value; }
        catch (Exception error) { Failed("Could not restore browser location: " + error.Message); }
        SetBrowser();
    }
    void SetBrowser()
    {
        _roots = [new(new(_directory), _directory, true)]; _expanded = new HashSet<string> { _directory }; _browserVersion++;
    }
    Task<IReadOnlyList<FilePickerEntry>> ListChildren(FilePickerEntry directory, System.Threading.CancellationToken token) => ListSupported(directory.Path, token);
    async Task<IReadOnlyList<FilePickerEntry>> ListSupported(PickerPath directory, System.Threading.CancellationToken token)
    {
        var items = await _provider.ListAsync(directory, token).ConfigureAwait(false);
        return items.Where(i => i.IsDirectory || _sourceFilters[0].Accepts(i.Name)).OrderByDescending(i => i.IsDirectory).ThenBy(i => i.Name).ToArray();
    }
    void RefreshBrowser() => SetBrowser();
    void PathEdited(PickerPath? path)
    {
        if (_disposed || _converting || _selectedPath == path) return;
        _selectedPath = path; _generation++; _saveOpen = false; _saveVersion++;
        _convertedSaveData = null;
    }
    void SourceCommitted(TextCommitEventArgs args) { if (args.Reason == TextCommitReason.Enter) ReloadSource(); }
    void SourcePicked(FilePickerResult result) { if (result.Path is { } path) LoadFile(path); }
    void SidebarActivate(FilePickerEntry item) { if (!item.IsDirectory) LoadFile(item.Path); }
    void ReloadSource() { if (_selectedPath is { } path) LoadFile(path); }
    void LoadFile(PickerPath path)
    {
        if (_converting || _disposed) return;
        _generation++; _saveOpen = false; _saveVersion++; _lastAction = ActionKind.Load;
        _convertedSaveData = null; _sourceSvg = _lottiePath = null; _loadedPath = null; _fileKind = FileKind.Unknown;
        try
        {
            var normalized = _provider.Normalize(path.Value); _selectedPath = normalized;
            var kind = ConverterService.Detect(normalized.Value);
            if (kind == FileKind.Unknown) throw new IOException("Choose an SVG or Lottie source file.");
            var contents = File.ReadAllText(normalized.Value);
            if (kind == FileKind.Svg) _sourceSvg = contents; else _lottiePath = normalized.Value;
            _loadedPath = normalized; _fileKind = kind; _directory = _provider.Parent(normalized)?.Value ?? _directory; SetBrowser();
            SetStatus("Loaded " + System.IO.Path.GetFileName(normalized.Value), OperationState.Completed);
            try { Directory.CreateDirectory(System.IO.Path.GetDirectoryName(SettingsPath)!); File.WriteAllText(SettingsPath, _directory); }
            catch (Exception error) { Failed("Source loaded; could not save browser location: " + error.Message); }
        }
        catch (Exception error) { Failed("Read error: " + error.Message); }
    }
    Task DoConvert()
    {
        if (_converting || _selectedPath == null || _disposed) return Task.CompletedTask;
        // The field is a draft until Enter/Browse/Convert accepts it. Never pair
        // that draft with a previous source preview, detected kind or save name.
        if (_loadedPath != _selectedPath) LoadFile(_selectedPath.Value);
        if (_loadedPath == null || _fileKind == FileKind.Unknown) return Task.CompletedTask;
        return _conversionTask = ConvertAsync();
    }
    async Task ConvertAsync()
    {
        if (_loadedPath is not { } source) return;
        var path = source.Value; var kind = _fileKind; var generation = ++_generation;
        var owner = OwnerWindow; var token = _lifetime.Token;
        _lastAction = ActionKind.Convert; _converting = true; _convertedSaveData = null;
        SetStatus("Converting… This conversion cannot be interrupted.", OperationState.Working);
        void ConvertOnOwner()
        {
            owner?.Dispatcher.VerifyAccess();
            if (_disposed || generation != _generation || token.IsCancellationRequested || owner?.ShutdownToken.IsCancellationRequested == true) return;
            try
            {
                _convertedSaveData = kind == FileKind.Svg ? ConverterService.ConvertSvgToPng(path) : ConverterService.ConvertLottieToGif(path);
                _saveName = System.IO.Path.GetFileNameWithoutExtension(path) + (kind == FileKind.Svg ? ".png" : ".gif");
                _outputFilters = [new(kind == FileKind.Svg ? "PNG" : "GIF", kind == FileKind.Svg ? ".png" : ".gif")];
                SetStatus($"Converted to {(kind == FileKind.Svg ? "PNG" : "GIF")} ({_convertedSaveData.Length} bytes). Save As chooses the destination.", OperationState.Completed);
            }
            catch (Exception error) { Failed("Conversion error: " + error.Message); }
            finally
            {
                if (!_disposed && generation == _generation)
                { _converting = false; StateHasChanged(); }
            }
        }
        try
        {
            StateHasChanged();
            // This tracked presentation wait must finish cancellation after the
            // ordinary application context stops. Graphics and all later UI state
            // stay in one explicit owner invocation, whose queued task is canceled
            // by Window shutdown if it has not started.
            await Task.Delay(20, token).ConfigureAwait(false);
            token.ThrowIfCancellationRequested();
            var execution = owner != null ? owner.Dispatcher.InvokeAsync(ConvertOnOwner) : InvokeAsync(ConvertOnOwner);
            try { await execution.ConfigureAwait(false); }
            // BeginShutdown cancels queued application invocations before it
            // signals ShutdownToken or starts component disposal. Observe that
            // invocation's cancellation even in this short ordering boundary.
            catch (OperationCanceledException) when (execution.IsCanceled) { }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested || owner?.ShutdownToken.IsCancellationRequested == true) { }
    }
    void OpenSave() { if (_convertedSaveData != null) { _saveVersion++; _saveOpen = true; } }
    void SaveCanceled(FilePickerResult _) => _logs.AppendLine("Save canceled; converted output retained.");
    void SaveSelected(FilePickerResult result)
    {
        if (_disposed || result.Path is not { } path || _convertedSaveData == null) return;
        _lastAction = ActionKind.Save;
        try
        {
            using var output = new FileStream(path.Value, result.Overwrite ? FileMode.Create : FileMode.CreateNew, FileAccess.Write);
            output.Write(_convertedSaveData);
            SetStatus("Saved to " + path.Value, OperationState.Completed);
        }
        catch (Exception error) { Failed("Write error: " + error.Message + " Choose Save As to retry."); }
    }
    Task Retry()
    {
        if (_lastAction == ActionKind.Convert) return DoConvert();
        if (_lastAction == ActionKind.Save) OpenSave(); else ReloadSource();
        return Task.CompletedTask;
    }
    void Failed(string text) => SetStatus(text, OperationState.Failed);
    void SetStatus(string text, OperationState state)
    { _status = new(text, state, state == OperationState.Failed ? StatusSeverity.Error : state == OperationState.Completed ? StatusSeverity.Success : StatusSeverity.Information); _logs.AppendLine(text); }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return; _disposed = true; _generation++; _lifetime.Cancel();
        try { await _conversionTask.ConfigureAwait(false); }
        finally { _lifetime.Dispose(); }
    }
}
