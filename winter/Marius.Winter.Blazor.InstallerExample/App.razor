@using Microsoft.AspNetCore.Components.Forms
@using System.Threading
@implements IAsyncDisposable
@* Configuration is validated without touching the filesystem. *@
@if (_page == Page.Configure)
{
    <ScrollPanel HorizontalScroll="ScrollMode.Never" Padding="@(new Thickness(12))">
        <FlexLayout Direction="Orientation.Vertical" Gap="10" />
        <Label Text="Install MyApp" FontSize="22" />
        <Label Text="Configuration simulation only. No files are installed." TextWrapping="ThorVG.TextWrap.Word" />
        <WinterForm @ref="_form" Model="_configuration" OnValidSubmit="StartInstall" OnInvalidSubmit="Invalid" OnReset="ResetConfiguration">
            <TextField Label="Application name" @bind-Value="_configuration.Name" HelpText="Name shown in the launcher." />
            <PathPicker Label="Destination" @bind-Value="_configuration.DestinationPath" ReadOnly="_readOnly" Provider="_fileProvider" InitialDirectory="@_browseDirectory" Mode="FilePickerMode.SelectFolder" HelpText="Choose an existing local folder or edit the absolute destination. The installation remains simulated." />
            <Panel>
                <FlexLayout Wrap="FlexWrap.Wrap" Gap="10" />
                <Checkbox Text="Read-only destination" @bind-IsChecked="_readOnly" />
            </Panel>
            <SelectField TItem="EnvironmentOption" TValue="string" Label="Environment" Items="_environments"
                         TextSelector="@(e => e.Name)" ValueSelector="@(e => e.Id)" @bind-Value="_configuration.Environment" />
            <CheckboxField Label="Shortcut" Text="Create desktop shortcut" @bind-Value="_configuration.Shortcut" />
            <CheckboxField Label="Startup" Text="Launch at startup" @bind-Value="_configuration.LaunchAtStartup" />
            <Panel>
                <FlexLayout Wrap="FlexWrap.Wrap" Gap="8" />
                <Button Text="Install" OnClick="Submit" />
                <Button Text="Reset" OnClick="Reset" />
                <Button Text="New configuration" OnClick="NewConfiguration" />
            </Panel>
        </WinterForm>
        <Label Text="@_configurationResult" TextWrapping="ThorVG.TextWrap.Word" />
    </ScrollPanel>
}

@* ── Page 2: Progress ── *@
@if (_page == Page.Progress)
{
    <Panel>
        <FlexLayout Direction="Orientation.Vertical" Gap="12" />

        <Label Text="Installing..." FontSize="22" />
        <Separator />

        <Label Text="@($"Progress: {(_progress * 100):F0}%")" />
        <StatusPanel Status="_operation" Cancel="CancelSimulation" />

        <LogView Buffer="_logs" LayoutData="@(new FlexItem { Grow = 1 })" />
    </Panel>
}

@* ── Page 3: Complete ── *@
@if (_page == Page.Complete)
{
    <Panel>
        <FlexLayout Direction="Orientation.Vertical" Gap="12" />

        <Label Text="Installation Simulation Complete" FontSize="22" />
        <Separator />

        <Label Text="@($"{_configuration.Name} was simulated with destination:")" />
        <Label Text="@_configuration.Destination" FontSize="14" />

        <Separator />
        <Label Text="@($"Environment: {EnvironmentName}")" />
        @if (_configuration.Shortcut)
        {
            <Label Text="Desktop shortcut selected." />
        }
        @if (_configuration.LaunchAtStartup)
        {
            <Label Text="Launch at startup selected." />
        }

        <Panel>
            <FlexLayout JustifyContent="JustifyContent.End" Gap="8" />
            <Button Text="Launch MyApp" OnClick="LaunchApp" />
        </Panel>
    </Panel>
}

@code {
    enum Page { Configure, Progress, Complete }

    [Microsoft.AspNetCore.Components.Parameter] public string? WorkspaceDirectory { get; set; }
    [Microsoft.AspNetCore.Components.Parameter] public IFilePickerProvider? FileProvider { get; set; }
    IFilePickerProvider _fileProvider = null!;
    string _browseDirectory = "";
    readonly LogBuffer _logs = new(120, 20000);
    OperationStatus _operation = new("Ready for a simulated installation.");
    protected override void OnInitialized()
    {
        _fileProvider = FileProvider ?? new LocalFilePickerProvider(WorkspaceDirectory);
        _browseDirectory = WorkspaceDirectory ?? Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        if (WorkspaceDirectory != null) _configuration.Destination = WorkspaceDirectory;
    }

    // ── State ──
    Page _page = Page.Configure;

    InstallerConfiguration _configuration = new();
    WinterForm _form = null!;
    bool _readOnly, _disposed;
    string _configurationResult = "Ready to validate a simulated configuration.";
    record EnvironmentOption(string Id, string Name);
    readonly EnvironmentOption[] _environments = [new("production", "Production"), new("staging", "Staging"), new("development", "Development")];
    string EnvironmentName => _environments.First(e => e.Id == _configuration.Environment).Name;
    CancellationTokenSource? _installationCancellation;
    Task _installationTask = Task.CompletedTask;
    long _generation;

    float _progress;

    // ── Simulated install steps ──
    static readonly (string message, int durationMs)[] _steps =
    [
        ("Preparing installation directory...", 300),
        ("Creating bin/", 150),
        ("Creating lib/", 150),
        ("Creating config/", 100),
        ("Creating logs/", 100),
        ("Copying myapp.dll...", 400),
        ("Copying myapp.deps.json...", 200),
        ("Copying myapp.runtimeconfig.json...", 150),
        ("Copying lib/core.dll...", 350),
        ("Copying lib/rendering.dll...", 300),
        ("Copying lib/networking.dll...", 250),
        ("Copying lib/data.dll...", 200),
        ("Copying lib/plugins.dll...", 300),
        ("Writing config/appsettings.json...", 200),
        ("Writing config/logging.json...", 150),
        ("Registering environment variables...", 300),
        ("Running post-install hooks...", 500),
        ("$ chmod +x bin/myapp", 200),
        ("$ ln -s bin/myapp /usr/local/bin/myapp", 200),
        ("Verifying installation integrity...", 400),
        ("Installation complete.", 100),
    ];

    Task Submit() => _form.SubmitAsync();
    Task Reset() => _form.ResetAsync();
    void Invalid(EditContext _) => _configurationResult = "Correct the highlighted configuration before starting the simulation.";
    void ResetConfiguration(EditContext _)
    {
        _configuration.Name = "MyApp"; _configuration.Destination = WorkspaceDirectory ?? "/opt/myapp";
        _configuration.Environment = "production"; _configuration.Shortcut = true; _configuration.LaunchAtStartup = false;
        _readOnly = false; _configurationResult = "Configuration reset.";
    }
    void NewConfiguration() { _configuration = new() { Destination = WorkspaceDirectory ?? "/opt/myapp" }; _readOnly = false; _configurationResult = "New configuration ready."; }
    Task StartInstall(EditContext context)
    {
        if (_disposed || _page != Page.Configure || !ReferenceEquals(context.Model, _configuration)) return Task.CompletedTask;
        _installationCancellation?.Cancel(); _installationCancellation?.Dispose();
        _installationCancellation = new CancellationTokenSource();
        _installationTask = SimulateAsync(++_generation, _installationCancellation.Token);
        return _installationTask;
    }
    async Task SimulateAsync(long generation, CancellationToken token)
    {
        _page = Page.Progress; _progress = 0; _logs.Clear(); _logs.AppendLine("Simulation only: no filesystem changes."); _operation = new("Simulating installation…", OperationState.Working, Progress: 0);
        try
        {
            for (int i = 0; i < _steps.Length; i++)
            {
                if (_disposed || token.IsCancellationRequested || generation != _generation) return;
                var (message, duration) = _steps[i];
                await InvokeAsync(() =>
                {
                    if (_disposed || token.IsCancellationRequested || generation != _generation) return;
                    _logs.AppendLine(message); _progress = (float)(i + 1) / _steps.Length; _operation = new(message, OperationState.Working, Progress: _progress);
                    StateHasChanged();
                });
                await Task.Delay(duration, token).ConfigureAwait(false);
            }
            await InvokeAsync(() =>
            {
                if (!_disposed && generation == _generation && !token.IsCancellationRequested) { _page = Page.Complete; StateHasChanged(); }
            });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            if (_disposed || generation != _generation) return;
            try { await InvokeAsync(() =>
            {
                if (!_disposed && generation == _generation) { _page = Page.Configure; _configurationResult = "Simulation canceled. Configuration retained; no files changed."; _logs.AppendLine(_configurationResult); StateHasChanged(); }
            }); }
            catch (OperationCanceledException) when (_disposed) { }
        }
    }
    async Task CancelSimulation()
    {
        _installationCancellation?.Cancel();
        await _installationTask;
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return; _disposed = true; _generation++; _installationCancellation?.Cancel();
        try { await _installationTask.ConfigureAwait(false); }
        finally { _installationCancellation?.Dispose(); }
    }

    void LaunchApp()
    {
        _page = Page.Configure;
        _configurationResult = "Simulation complete. Review or reset the configuration.";
    }
}
