@namespace Marius.Winter.Blazor.Playground.Scenarios
@using System
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Modal = Marius.Winter.Blazor.Elements.ModalDialog

<ScrollPanel Layout="@(new Marius.Winter.StackLayout { Spacing = 0 })" HorizontalScroll="ScrollMode.Never" Padding="@(new Thickness(0))">
<Panel Layout="@Column" Padding="@(new Thickness(12))">
    <Label Text="Windows and dialogs" FontSize="22" />
    <Label Text="Edit your profile, save it, or cancel to keep the original. The background counter waits while the editor is open." TextWrapping="ThorVG.TextWrap.Word" />
    <Panel Layout="@Row" Padding="@(new Thickness(0))">
        @if (_showOpener) { <Button Text="Edit profile" OnClick="Open" /> }
        <Button Text="Background counter" OnClick="@(() => _counter++)" />
        <Button Text="Modeless Settings" OnClick="@(() => _settings = true)" />
        <Button Text="Recreate dialog" OnClick="Recreate" />
        <Button Text="Reset" OnClick="Reset" />
    </Panel>
    <Checkbox Text="Close on backdrop" @bind-IsChecked="_backdrop" />
    <Label Text="@($"Profile: {_savedName} · Background counter: {_counter}")" />
    <Label Text="@_result" TextWrapping="ThorVG.TextWrap.Word" />
    <Panel Layout="@Row" Padding="@(new Thickness(0))">
        <Button Text="Light" OnClick="@(() => SetTheme(false))" />
        <Button Text="Dark" OnClick="@(() => SetTheme(true))" />
        <Button Text="Larger text" OnClick="@(() => { _large = !_large; SetSize(); })" />
    </Panel>
    @if (_mounted)
    {
        <ModalDialog @ref="_modal" @key="_identity" @bind-IsOpen="_open" Title="Edit profile" Width="560" Height="440"
               CloseGuard="Guard" Closed="Completed"
               CloseOnBackdrop="_backdrop" ResetVersion="_reset">
            <Body>
                <WinterForm @ref="_form" Model="_draft" OnValidSubmit="SubmitProfile" OnInvalidSubmit="InvalidProfile">
                    <TextField Label="Display name (required)" @bind-Value="_draft.Name" ResetVersion="_reset" />
                    <Field Label="Workspace"><ComboBox Items="@Environments" @bind-SelectedIndex="_environment" /></Field>
                    <TextField Label="Biography (Enter adds a line)" @bind-Value="_draft.Biography" ResetVersion="_reset" Multiline="true" MultilineHeight="76" />
                    <Checkbox Text="Protect unsaved edits (checks before cancel)" @bind-IsChecked="_protect" />
                    <Label Text="@_error" TextWrapping="ThorVG.TextWrap.Word" />
                </WinterForm>
            </Body>
            <Footer>
                <Panel Layout="@Row" Padding="@(new Thickness(0))">
                    <Button Text="Save" OnClick="Submit" />
                    <Button Text="Cancel" OnClick="@(() => Close(DialogCloseReason.Cancel))" />
                    <Button Text="Remove opener" OnClick="@(() => _showOpener = false)" />
                    <Button Text="Remove dialog" OnClick="Remove" />
                </Panel>
            </Footer>
        </ModalDialog>
    }
    @if (_settings)
    {
        <DialogWindow Title="Modeless Settings" Width="280" Height="170" Layout="@(new Marius.Winter.StackLayout { Spacing = 8 })" OnClose="@(() => _settings = false)">
            <Label Text="Background actions remain available." />
            <Checkbox Text="Show profile hints" IsChecked="true" />
        </DialogWindow>
    }
</Panel>
</ScrollPanel>

@code {
    [Parameter] public Window? OwnerWindow { get; set; }
    private Modal? _modal;
    private Marius.Winter.Blazor.Elements.WinterForm? _form;
    public sealed class ProfileDraft
    {
        [Required(ErrorMessage = "Enter a display name before saving.")]
        public string Name { get; set; } = "Marius";
        public string Biography { get; set; } = "Designing a quiet workspace.";
    }
    private ProfileDraft _draft = new();
    private string _savedName = "Marius", _savedBio = "Designing a quiet workspace.";
    private string _name { get => _draft.Name; set => _draft.Name = value; }
    private string _biography { get => _draft.Biography; set => _draft.Biography = value; }
    private string _error = "";
    private string _result = "Ready to edit. Save accepts changes; Escape or Cancel keeps the original.";
    private bool _open, _backdrop, _protect, _settings, _large;
    private bool _mounted = true, _showOpener = true;
    private int _environment, _savedEnvironment, _counter, _identity;
    private long _reset;
    private static readonly string[] Environments = Enumerable.Range(0, 24).Select(i => i == 0 ? "Personal studio" : $"Shared studio {i:00} · Žąsis").ToArray();
    private static readonly Marius.Winter.FlexLayout Column = new() { Direction = Orientation.Vertical, Gap = 10 };
    private static readonly Marius.Winter.FlexLayout Row = new() { Wrap = FlexWrap.Wrap, Gap = 8 };
    private void Open()
    {
        _mounted = true; _draft = new ProfileDraft { Name = _savedName, Biography = _savedBio }; _environment = _savedEnvironment;
        _protect = false; _error = ""; _reset++; _open = true;
    }
    private async Task Close(DialogCloseReason reason) { if (_modal != null) await _modal.RequestCloseAsync(reason); }
    private Task Submit() => _form?.SubmitAsync() ?? Task.CompletedTask;
    private Task SubmitProfile(EditContext context) => Close(DialogCloseReason.Accepted);
    private void InvalidProfile(EditContext context) => _error = "Enter a display name before saving.";
    private async ValueTask<bool> Guard(DialogResult result, CancellationToken token)
    {
        if (!_protect || result.Accepted) return true;
        _error = "Checking unsaved edits…"; StateHasChanged();
        await Task.Delay(350, token);
        bool unchanged = _name == _savedName && _biography == _savedBio && _environment == _savedEnvironment;
        _error = unchanged ? "" : "Unsaved edits: Save, or turn off protection to discard them.";
        StateHasChanged(); return unchanged;
    }
    private void Completed(DialogResult result)
    {
        if (result.Accepted) { _savedName = _name; _savedBio = _biography; _savedEnvironment = _environment; }
        _result = result.Accepted ? $"Saved profile: {_savedName}." : $"Canceled ({result.Reason}); kept {_savedName}.";
    }
    private void Remove() { _open = false; _mounted = false; _result = "Editor removed; profile kept. Recreate it to continue."; }
    private void Recreate() { _open = false; _identity++; _mounted = true; _result = "Editor recreated. Open it to edit your profile."; }
    private void SetTheme(bool dark) { if (OwnerWindow != null) OwnerWindow.Theme = dark ? Theme.Dark : Theme.Light; SetSize(); }
    private void SetSize()
    {
        if (OwnerWindow == null) return;
        var size = _large ? 22 : 16;
        foreach (var style in new[] { OwnerWindow.Theme.Panel, OwnerWindow.Theme.TextBox, OwnerWindow.Theme.Button, OwnerWindow.Theme.Label, OwnerWindow.Theme.Checkbox }) style.FontSize = size;
    }
    private void Reset()
    {
        _open = false; _reset++; _showOpener = true; _mounted = true;
        _savedName = "Marius"; _savedBio = "Designing a quiet workspace."; _savedEnvironment = _counter = 0;
        _backdrop = _settings = _large = false; SetSize();
        _result = "Ready to edit. Save accepts changes; Escape or Cancel keeps the original.";
    }
}
