@using Marius.Winter.Blazor.Playground.Scenarios
@using Microsoft.AspNetCore.Components

<Panel @ref="_root" Padding="@(new Thickness(12))">
    <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Auto(), TrackSize.Fr() })" RowGap="12" />
    <Panel>
        <FlexLayout Wrap="FlexWrap.Wrap" Gap="10" />
        <ComboBox Items="@_scenarioNames" @bind-SelectedIndex="_scenario" MinWidth="240" />
        <Button Text="Toggle theme" OnClick="ToggleTheme" />
        <Button Text="Larger text" OnClick="ToggleTextSize" />
    </Panel>
    <Panel>
        <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
        <Panel Visible="@(_scenario == 0)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <ProfileAndVolume />
        </Panel>
        <Panel Visible="@(_scenario == 1)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <HelpRichDisplay />
        </Panel>
        <Panel Visible="@(_scenario == 2)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <ResizableWorkspace />
        </Panel>
        <Panel Visible="@(_scenario == 3)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <OperationFeedback />
        </Panel>
        <Panel Visible="@(_scenario == 4)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <LegacyGallery OnToggleTheme="ToggleTheme" />
        </Panel>
        <Panel Visible="@(_scenario == 5)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <ProjectBrowser OwnerWindow="OwnerWindow" />
        </Panel>
        <Panel Visible="@(_scenario == 6)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <EnvironmentAndTabs />
        </Panel>
        <Panel Visible="@(_scenario == 7)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <Notes OwnerWindow="OwnerWindow" />
        </Panel>
        <Panel Visible="@(_scenario == 8)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <InstallerSetup />
        </Panel>
        <Panel Visible="@(_scenario == 9)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <WindowsAndDialogs OwnerWindow="OwnerWindow" />
        </Panel>
        <Panel Visible="@(_scenario == 10)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <AssetCatalog />
        </Panel>
        <Panel Visible="@(_scenario == 11)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <PreviewAndCommands />
        </Panel>
        <Panel Visible="@(_scenario == 12)" LayoutData="@(new GridItem())">
            <GridLayout Columns="@(new[] { TrackSize.Fr() })" Rows="@(new[] { TrackSize.Fr() })" />
            <Files OwnerWindow="OwnerWindow" />
        </Panel>
    </Panel>
</Panel>

@code {
    [Parameter] public Window? OwnerWindow { get; set; }
    private Marius.Winter.Blazor.Elements.Panel? _root;
    private readonly string[] _scenarioNames = ["Profile and volume", "Help and rich display", "Resizable workspace", "Operation feedback", "Existing demos", "Project browser", "Environment and tabs", "Notes", "Installer setup", "Windows and dialogs", "Asset catalog", "Preview and commands", "Files"];
    private int _scenario;
    private bool _large;
    private void ToggleTheme() => ApplyAppearance(toggleTheme: true);
    private void ToggleTextSize() { _large = !_large; ApplyAppearance(); }
    private void ApplyAppearance(bool toggleTheme = false)
    {
        var window = OwnerWindow ?? (_root?.ElementHandler as IWinterElementHandler)?.ElementControl.OwnerWindow;
        if (window == null) return;
        bool dark = window.Theme.WindowBackground.R < .5f;
        if (toggleTheme) dark = !dark;
        var theme = dark ? Theme.Dark : Theme.Light;
        foreach (var style in new[] { theme.Button, theme.TextBox, theme.Checkbox, theme.Slider, theme.Label, theme.ProgressBar, theme.Tooltip, theme.MenuBar })
            style.FontSize *= _large ? 1.3f : 1;
        window.Theme = theme;
    }
}
